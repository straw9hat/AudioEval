# Copy to .env (never commit .env). Values shown are placeholders.

# Login: comma-separated user:hash pairs. Create hashes with: python -m audioeval hash-password
AUDIOEVAL_USERS=evaluator:pbkdf2_sha256$600000$REPLACE$REPLACE
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
AUDIOEVAL_SECRET_KEY=REPLACE_ME
# Keep true when served over HTTPS (production). Set false only for plain-HTTP localhost.
AUDIOEVAL_COOKIE_SECURE=true
# true only behind a reverse proxy that appends X-Forwarded-For (the Docker image sets this).
AUDIOEVAL_TRUST_PROXY=true

# Service limits and retention
AUDIOEVAL_MAX_UPLOAD_MB=2048
AUDIOEVAL_MAX_FILES=2000
AUDIOEVAL_WORKERS=2
AUDIOEVAL_RETENTION_HOURS=72
AUDIOEVAL_KEEP_AUDIO=false
AUDIOEVAL_DATA_DIR=/data/jobs

# Optional local models (directories; see docs/MODEL_SETUP.md). Leave empty for the acoustic baseline.
AUDIOEVAL_EMOTION_MODEL=
AUDIOEVAL_EVENT_MODEL=
AUDIOEVAL_ASR_MODEL=
AUDIOEVAL_TEXT_MODEL=
AUDIOEVAL_OVERLAP_MODEL=
AUDIOEVAL_DEVICE=cpu
AUDIOEVAL_CALIBRATION_PATH=

# Decision thresholds (defaults shown)
AUDIOEVAL_LONG_SILENCE_S=10
AUDIOEVAL_CUSTOMER_CHANNEL=auto
